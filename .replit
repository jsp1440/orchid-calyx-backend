modules = ["python-3.11", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["libxcrypt"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Calyx API"

[[workflows.workflow]]
name = "Calyx API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-3000}"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[deployment]
run = ["bash", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-3000}"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 3000
externalPort = 3000
